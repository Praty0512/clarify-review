# ---- Provider -------------------------------------------------------------
# "gemini" (default) or "anthropic". Nothing above llm/ changes when you switch.
CLARIFYREVIEW_PROVIDER=gemini

# Gemini: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic: only needed if CLARIFYREVIEW_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ---- Model overrides (optional) -------------------------------------------
# Empty means "use the provider default". Run `clarifyreview models` to see
# what your key can actually reach before overriding.
CLARIFYREVIEW_MODEL_REVIEW=
CLARIFYREVIEW_MODEL_QUESTION=
CLARIFYREVIEW_MODEL_JUDGE=
CLARIFYREVIEW_MODEL_ORACLE=
CLARIFYREVIEW_MODEL_SAMPLING=

# ---- GitHub ---------------------------------------------------------------
# Fine-grained token, ideally owned by a separate bot account. See
# docs/github_bot_runbook.md for the permissions and webhook setup.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ---- Live bot (all optional) ------------------------------------------------
# Set only if the bot has its own account: its PRs are never asked about and its
# comments never count as answers. The bot's comments are recognised by a hidden
# marker either way, and GitHub Apps by their "Bot" account type.
CLARIFYREVIEW_BOT_LOGIN=
# Seconds between sweeps for parked runs whose deadline passed. 0 = off
# (use `clarifyreview sweep` from cron instead).
CLARIFYREVIEW_SWEEP_INTERVAL_S=300
CLARIFYREVIEW_REVIEW_ON_PUSH=true
CLARIFYREVIEW_SKIP_DRAFTS=true
# GitHub rejects comments above 65,536 characters.
CLARIFYREVIEW_MAX_COMMENT_CHARS=60000
# What runs.condition says for production runs. Never a Study A condition.
CLARIFYREVIEW_BOT_CONDITION=github_live
# Also submit a GitHub pull request review (verdict + comments on changed lines).
CLARIFYREVIEW_PR_REVIEW=true
# Who may answer the bot's question: author | anyone | comma-separated logins
# allowed besides the author (e.g. alice, bob).
CLARIFYREVIEW_ANSWER_FROM=author
# Large repositories: sparse checkout of the PR's merge base for context, and
# extra globs to leave out of review on top of the built-in lockfile/generated list.
CLARIFYREVIEW_CHECKOUT=true
CLARIFYREVIEW_CHECKOUT_DIR=data/checkouts
CLARIFYREVIEW_SKIP_GLOBS=
# The default question model (gemma) allows 16k input tokens/min on the free
# tier, too few for large PRs; the live bot can use the review model instead.
# CLARIFYREVIEW_MODEL_QUESTION=gemini-3.5-flash-lite
# GitHub Enterprise: https://ghe.example.com/api/v3
GITHUB_API_URL=https://api.github.com
# GitHub App instead of a token (needs `pip install -e ".[app]"`).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# ---- Storage and behaviour ------------------------------------------------
CLARIFYREVIEW_DB=data/clarifyreview.db

# heuristic | classifier | sampling | perturbation
CLARIFYREVIEW_DETECTOR=heuristic

# Seconds the clarification loop waits for a developer reply.
# 0 disables waiting (the benchmark harness answers synchronously).
CLARIFYREVIEW_CLARIFY_TIMEOUT=86400

# ---- Local models via Ollama (CLARIFYREVIEW_PROVIDER=ollama) ----
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_NUM_CTX_MAX=16384
OLLAMA_NUM_PREDICT_MAX=4096
OLLAMA_THINK=off
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT_S=600

