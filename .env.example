# ---- Provider -------------------------------------------------------------
# "gemini" (default) or "anthropic". Nothing above llm/ changes when you switch.
CLARIFYREVIEW_PROVIDER=gemini

# Gemini: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic: only needed if CLARIFYREVIEW_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# ---- Model overrides (optional) -------------------------------------------
# Empty means "use the provider default". Run `clarifyreview models` to see
# what your key can actually reach before overriding.
CLARIFYREVIEW_MODEL_REVIEW=
CLARIFYREVIEW_MODEL_QUESTION=
CLARIFYREVIEW_MODEL_JUDGE=
CLARIFYREVIEW_MODEL_ORACLE=
CLARIFYREVIEW_MODEL_SAMPLING=

# ---- GitHub ---------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ---- Storage and behaviour ------------------------------------------------
CLARIFYREVIEW_DB=data/clarifyreview.db

# heuristic | classifier | sampling | perturbation
CLARIFYREVIEW_DETECTOR=heuristic

# Seconds the clarification loop waits for a developer reply.
# 0 disables waiting (the benchmark harness answers synchronously).
CLARIFYREVIEW_CLARIFY_TIMEOUT=86400
